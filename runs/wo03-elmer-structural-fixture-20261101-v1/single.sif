Header
  CHECK KEYWORDS Warn
  Mesh DB "." "mesh"
End
Simulation
  Coordinate System = Cartesian
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
End
Body 1
  Equation = 1
  Material = 1
End
Material 1
  Youngs Modulus = Real 100000000
  Poisson Ratio = Real 0.0
End
Body 2
  Equation = 1
  Material = 2
End
Material 2
  Youngs Modulus = Real 10000000000
  Poisson Ratio = Real 0.0
End
Equation 1
  Active Solvers(2) = 1 2
End
Solver 1
  Equation = Elasticity
  Variable = String "Displacement"
  Variable DOFs = Integer 3
  Procedure = File "/Users/kudratsingh/Machine-Learning-Projects/rocket-twin/.cache/elmer-evaluation/structural-module-v1/artifacts/StressSolve.dylib" "StressSolver"
  Displace Mesh = Logical False
  Calculate Loads = Logical True
  Calculate Boundary Fluxes = Logical True
  Linear System Solver = Direct
  Linear System Direct Method = UMFPACK
  Linear System Max Iterations = 2000
  Linear System Convergence Tolerance = 1.0e-12
  Linear System Abort Not Converged = Logical True
  Nonlinear System Max Iterations = Integer 1
  Steady State Convergence Tolerance = 1.0e-12
End
Solver 2
  Equation = Result Output
  Procedure = File "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = "field"
  Vtu Format = Logical True
  Binary Output = Logical True
  Single Precision = Logical False
End
Boundary Condition 4
  Target Boundaries(1) = 4
  Displacement 1 = Real 0
  Displacement 2 = Real 0
  Displacement 3 = Real 0
End
Boundary Condition 1
  Target Boundaries(1) = 1
  Force 3 = Real 9375000
End
Boundary Condition 2
  Target Boundaries(1) = 2
  Force 3 = Real 0
End
Boundary Condition 3
  Target Boundaries(1) = 3
  Force 3 = Real 0
End
